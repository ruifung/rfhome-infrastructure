{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "aaaaRecordSet.ts",
        "arecordSet.ts",
        "cnameRecord.ts",
        "config/index.ts",
        "config/vars.ts",
        "getARecordSet.ts",
        "getAaaaRecordSet.ts",
        "getCnameRecordSet.ts",
        "getMxRecordSet.ts",
        "getNsRecordSet.ts",
        "getPtrRecordSet.ts",
        "getSrvRecordSet.ts",
        "getTxtRecordSet.ts",
        "index.ts",
        "mxRecordSet.ts",
        "nsRecordSet.ts",
        "provider.ts",
        "ptrRecord.ts",
        "srvRecordSet.ts",
        "txtRecordSet.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "utilities.ts"
    ]
}
